{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 2,
  "id": "izumi.reel",
  "name": "Reel",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "Modelled on the AnimePahe watch page: a flat charcoal canvas, a top bar, no featured banner, and Home as a grid of 16:9 snapshot tiles with the format pinned to each still. The watch page docks the player at the top with the server switcher and an episode snapshot grid beneath it; the series page lists episodes as snapshots with an episode badge. On phones the same grid runs under a flush bottom bar with a line marker.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 0% 9%",
      "foreground": "0 0% 94%",
      "muted": "0 0% 16%",
      "mutedForeground": "0 0% 64%",
      "primary": "200 85% 55%",
      "primaryForeground": "0 0% 8%",
      "secondary": "0 0% 16%",
      "secondaryForeground": "0 0% 94%",
      "accent": "0 0% 16%",
      "accentForeground": "0 0% 94%",
      "border": "0 0% 22%",
      "input": "0 0% 16%",
      "ring": "200 85% 55%",
      "card": "0 0% 13%",
      "cardForeground": "0 0% 94%",
      "theme": "200 85% 55%"
    },
    "radius": 0.4,
    "font": "system",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "compact",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": {
        "nav": "top",
        "compact": true,
        "bottomNav": {
          "style": "bar",
          "labels": "always",
          "indicator": "line",
          "height": 56,
          "iconSize": 20,
          "blur": false,
          "border": true,
          "background": "#171717"
        }
      },
      "player": {
        "seekbarHeight": 4,
        "seekbarColor": "theme",
        "layout": "docked",
        "dock": {
          "episodes": "below",
          "width": 100,
          "align": "center"
        }
      },
      "hero": {
        "hidden": true
      },
      "rows": {
        "defaults": {
          "layout": "grid",
          "width": 224,
          "gap": 14,
          "spacing": 36,
          "radius": 6,
          "titleSize": 17,
          "aspect": "landscape",
          "heading": {
            "weight": 800,
            "viewMore": "text"
          }
        },
        "byId": {
          "continue": {
            "layout": "grid",
            "width": 224,
            "aspect": "landscape",
            "radius": 6
          }
        }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": {
            "gap": 5
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "backdrop",
                  "style": {
                    "aspect": "16 / 9",
                    "radius": 6,
                    "fit": "cover"
                  }
                },
                {
                  "type": "text",
                  "field": "format",
                  "when": {
                    "field": "format"
                  },
                  "style": {
                    "fontSize": 11,
                    "fontWeight": 700,
                    "radius": 4,
                    "padding": 6,
                    "anchor": "top-start",
                    "color": "#FFFFFF",
                    "background": "#000000B3"
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 13,
                "lines": 1
              }
            },
            {
              "type": "row",
              "style": {
                "gap": 10,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "field": "year",
                  "when": {
                    "field": "year"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                },
                {
                  "type": "row",
                  "when": {
                    "field": "score"
                  },
                  "style": {
                    "gap": 3,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "icon",
                      "icon": "score",
                      "style": {
                        "fontSize": 11,
                        "color": "theme"
                      }
                    },
                    {
                      "type": "text",
                      "field": "score",
                      "style": {
                        "color": "muted-foreground",
                        "fontSize": 12,
                        "fontWeight": 700
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": {
            "gap": 5
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "still",
                  "style": {
                    "aspect": "16 / 9",
                    "radius": 6,
                    "fit": "cover"
                  }
                },
                {
                  "type": "text",
                  "field": "episodeNumber",
                  "style": {
                    "color": "#FFFFFF",
                    "fontSize": 11,
                    "fontWeight": 800,
                    "anchor": "top-start",
                    "padding": 6,
                    "background": "#000000B3",
                    "radius": 4
                  }
                },
                {
                  "type": "meter",
                  "field": "progress",
                  "when": {
                    "field": "progress"
                  },
                  "style": {
                    "anchor": "bottom-start",
                    "minHeight": 3
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 13,
                "lines": 1
              }
            },
            {
              "type": "text",
              "field": "episodeTitle",
              "when": {
                "field": "episodeTitle"
              },
              "style": {
                "color": "muted-foreground",
                "fontSize": 12,
                "lines": 1
              }
            }
          ]
        }
      },
      "detail": {
        "layout": "stack",
        "bannerHidden": false,
        "posterWidth": 180,
        "bannerHeight": 26,
        "tabs": "underline",
        "cta": "default",
        "episodes": {
          "placement": "below",
          "arrangement": "grid",
          "hover": "scale",
          "order": "flip",
          "search": true,
          "card": {
            "type": "overlay",
            "children": [
              {
                "type": "artwork",
                "artwork": "still",
                "style": {
                  "aspect": "16 / 9",
                  "radius": 6,
                  "fit": "cover"
                }
              },
              {
                "type": "text",
                "field": "episodeNumber",
                "style": {
                  "color": "#FFFFFF",
                  "fontSize": 11,
                  "fontWeight": 800,
                  "anchor": "bottom-start",
                  "padding": 6,
                  "background": "#000000B3",
                  "radius": 4
                }
              },
              {
                "type": "meter",
                "field": "progress",
                "when": {
                  "field": "progress"
                },
                "style": {
                  "anchor": "bottom-start",
                  "minHeight": 3
                }
              }
            ]
          }
        }
      },
      "mobile": {
        "density": "compact",
        "rows": {
          "defaults": {
            "layout": "grid",
            "width": 160,
            "gap": 10,
            "spacing": 26,
            "radius": 6,
            "titleSize": 16
          }
        },
        "detail": {
          "layout": "stack",
          "posterWidth": 120,
          "bannerHeight": 26,
          "cta": "large",
          "tabs": "underline",
          "episodes": {
            "placement": "tab",
            "arrangement": "grid"
          }
        }
      }
    }
  }
}
