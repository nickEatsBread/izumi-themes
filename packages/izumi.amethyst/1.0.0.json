{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 2,
  "id": "izumi.amethyst",
  "name": "Amethyst",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "Modelled on the AniWave site: deep slate surfaces with a soft purple accent and a top bar. The featured swiper shows a slide counter, format and year tags and square-cornered buttons; section titles are small uppercase text; posters have a format tag pinned to the bottom. The watch page docks the player with a scrolling episode list beside it; the series page splits info and an episode rail under underlined tabs. Phones get a flush bottom bar with a dot under the active tab.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "250 14% 8%",
      "foreground": "250 12% 95%",
      "muted": "250 10% 15%",
      "mutedForeground": "250 8% 64%",
      "primary": "258 90% 76%",
      "primaryForeground": "250 14% 8%",
      "secondary": "250 10% 15%",
      "secondaryForeground": "250 12% 95%",
      "accent": "250 10% 15%",
      "accentForeground": "250 12% 95%",
      "border": "250 10% 21%",
      "input": "250 10% 15%",
      "ring": "258 90% 76%",
      "card": "250 12% 12%",
      "cardForeground": "250 12% 95%",
      "theme": "258 90% 76%"
    },
    "radius": 0.35,
    "font": "system",
    "fontScale": 1,
    "backdrop": "mesh",
    "backdropStrength": 0.16,
    "glassBlur": 10,
    "presentation": {
      "density": "compact",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": {
        "nav": "top",
        "compact": true,
        "bottomNav": {
          "style": "bar",
          "labels": "active",
          "indicator": "dot",
          "height": 56,
          "iconSize": 22,
          "blur": true,
          "border": true,
          "background": "#15121FE6",
          "activeColor": "#A78BFA"
        }
      },
      "player": {
        "seekbarHeight": 4,
        "seekbarColor": "theme",
        "layout": "docked",
        "dock": {
          "episodes": "right",
          "width": 66,
          "align": "start"
        }
      },
      "hero": {
        "height": 54,
        "mobileHeight": 48,
        "rotate": true,
        "interval": 8,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            {
              "type": "artwork",
              "artwork": "backdrop",
              "style": {
                "anchor": "fill",
                "fit": "cover"
              }
            },
            {
              "type": "stack",
              "style": {
                "anchor": "bottom-start",
                "padding": 36,
                "gap": 10,
                "maxWidth": 720
              },
              "children": [
                {
                  "type": "row",
                  "style": {
                    "gap": 6,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "text",
                      "field": "format",
                      "when": {
                        "field": "format"
                      },
                      "style": {
                        "fontSize": 11,
                        "fontWeight": 700,
                        "radius": 4,
                        "padding": 6,
                        "color": "#FFFFFF",
                        "background": "#A78BFA33"
                      }
                    },
                    {
                      "type": "text",
                      "field": "year",
                      "when": {
                        "field": "year"
                      },
                      "style": {
                        "fontSize": 11,
                        "fontWeight": 700,
                        "radius": 4,
                        "padding": 6,
                        "color": "#FFFFFF",
                        "background": "#FFFFFF1F"
                      }
                    },
                    {
                      "type": "row",
                      "when": {
                        "field": "episodeCount"
                      },
                      "style": {
                        "gap": 3,
                        "background": "#FFFFFF1F",
                        "radius": 4,
                        "padding": 6
                      },
                      "children": [
                        {
                          "type": "text",
                          "field": "episodeCount",
                          "style": {
                            "color": "#FFFFFF",
                            "fontSize": 11,
                            "fontWeight": 700
                          }
                        },
                        {
                          "type": "text",
                          "text": "EP",
                          "style": {
                            "color": "#FFFFFF",
                            "fontSize": 11,
                            "fontWeight": 700
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "field": "title",
                  "style": {
                    "color": "#FFFFFF",
                    "fontSize": 40,
                    "fontWeight": 800,
                    "lines": 2
                  }
                },
                {
                  "type": "text",
                  "field": "genres",
                  "when": {
                    "field": "genres"
                  },
                  "style": {
                    "color": "#D8D2F5",
                    "fontSize": 13,
                    "fontWeight": 700
                  }
                },
                {
                  "type": "text",
                  "field": "description",
                  "when": {
                    "field": "description"
                  },
                  "style": {
                    "color": "#E2DEF3",
                    "fontSize": 14,
                    "maxWidth": 600,
                    "lines": 2
                  }
                },
                {
                  "type": "row",
                  "style": {
                    "gap": 10,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "action",
                      "text": "Watch now",
                      "action": "play",
                      "style": {
                        "background": "#A78BFA",
                        "color": "#15121F",
                        "minHeight": 42,
                        "radius": 6,
                        "fontWeight": 800
                      }
                    },
                    {
                      "type": "action",
                      "text": "Info",
                      "action": "details",
                      "style": {
                        "background": "#FFFFFF1F",
                        "color": "#FFFFFF",
                        "minHeight": 42,
                        "radius": 6,
                        "fontWeight": 700
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "indicator": {
          "style": "counter",
          "position": "end",
          "color": "#A78BFA"
        }
      },
      "rows": {
        "defaults": {
          "layout": "carousel",
          "width": 140,
          "gap": 12,
          "spacing": 32,
          "radius": 4,
          "titleSize": 16,
          "aspect": "poster",
          "heading": {
            "weight": 700,
            "transform": "uppercase",
            "viewMore": "text"
          }
        },
        "byId": {
          "continue": {
            "layout": "carousel",
            "width": 256,
            "aspect": "landscape",
            "radius": 4
          }
        }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": {
            "gap": 5
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "poster",
                  "style": {
                    "aspect": "2 / 3",
                    "radius": 4,
                    "fit": "cover"
                  }
                },
                {
                  "type": "text",
                  "field": "format",
                  "when": {
                    "field": "format"
                  },
                  "style": {
                    "fontSize": 10,
                    "fontWeight": 700,
                    "radius": 3,
                    "padding": 4,
                    "anchor": "bottom-start",
                    "color": "#FFFFFF",
                    "background": "#A78BFACC"
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 12,
                "lines": 2
              }
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": {
            "gap": 0,
            "background": "card",
            "radius": 4
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "still",
                  "style": {
                    "aspect": "16 / 9",
                    "radius": 4,
                    "fit": "cover"
                  }
                },
                {
                  "type": "meter",
                  "field": "progress",
                  "when": {
                    "field": "progress"
                  },
                  "style": {
                    "anchor": "bottom-start",
                    "minHeight": 4,
                    "background": "#FFFFFF33"
                  }
                }
              ]
            },
            {
              "type": "stack",
              "style": {
                "padding": 12,
                "gap": 3
              },
              "children": [
                {
                  "type": "text",
                  "field": "title",
                  "style": {
                    "fontWeight": 800,
                    "fontSize": 14,
                    "lines": 1
                  }
                },
                {
                  "type": "row",
                  "style": {
                    "gap": 8,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "text",
                      "field": "episodeNumber",
                      "style": {
                        "color": "theme",
                        "fontSize": 12,
                        "fontWeight": 800
                      }
                    },
                    {
                      "type": "text",
                      "field": "episodeTitle",
                      "when": {
                        "field": "episodeTitle"
                      },
                      "style": {
                        "color": "muted-foreground",
                        "fontSize": 12,
                        "lines": 1
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "split",
        "bannerHidden": false,
        "posterWidth": 200,
        "bannerHeight": 26,
        "tabs": "underline",
        "cta": "default",
        "episodes": {
          "placement": "right",
          "arrangement": "list",
          "hover": "none",
          "order": "flip",
          "search": true,
          "card": {
            "type": "row",
            "style": {
              "gap": 12,
              "align": "center",
              "wrap": "nowrap",
              "padding": 8,
              "radius": 4,
              "background": "card"
            },
            "children": [
              {
                "type": "overlay",
                "style": {
                  "width": 30,
                  "shrink": 0
                },
                "children": [
                  {
                    "type": "artwork",
                    "artwork": "still",
                    "style": {
                      "aspect": "16 / 9",
                      "radius": 2,
                      "fit": "cover"
                    }
                  },
                  {
                    "type": "meter",
                    "field": "progress",
                    "when": {
                      "field": "progress"
                    },
                    "style": {
                      "anchor": "bottom-start",
                      "minHeight": 3
                    }
                  }
                ]
              },
              {
                "type": "stack",
                "style": {
                  "grow": 1,
                  "gap": 3
                },
                "children": [
                  {
                    "type": "row",
                    "style": {
                      "gap": 8,
                      "align": "center",
                      "wrap": "nowrap"
                    },
                    "children": [
                      {
                        "type": "text",
                        "field": "episodeNumber",
                        "style": {
                          "color": "theme",
                          "fontSize": 12,
                          "fontWeight": 800,
                          "shrink": 0
                        }
                      },
                      {
                        "type": "text",
                        "field": "episodeTitle",
                        "style": {
                          "fontWeight": 700,
                          "fontSize": 14,
                          "lines": 1,
                          "grow": 1
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "mobile": {
        "hero": {
          "height": 48,
          "template": {
            "type": "overlay",
            "children": [
              {
                "type": "artwork",
                "artwork": "backdrop",
                "style": {
                  "anchor": "fill",
                  "fit": "cover"
                }
              },
              {
                "type": "stack",
                "style": {
                  "anchor": "bottom-start",
                  "padding": 16,
                  "gap": 8,
                  "width": 100
                },
                "children": [
                  {
                    "type": "row",
                    "style": {
                      "gap": 6,
                      "align": "center"
                    },
                    "children": [
                      {
                        "type": "text",
                        "field": "format",
                        "when": {
                          "field": "format"
                        },
                        "style": {
                          "fontSize": 11,
                          "fontWeight": 700,
                          "radius": 4,
                          "padding": 6,
                          "color": "#FFFFFF",
                          "background": "#A78BFA33"
                        }
                      },
                      {
                        "type": "text",
                        "field": "year",
                        "when": {
                          "field": "year"
                        },
                        "style": {
                          "fontSize": 11,
                          "fontWeight": 700,
                          "radius": 4,
                          "padding": 6,
                          "color": "#FFFFFF",
                          "background": "#FFFFFF1F"
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "field": "title",
                    "style": {
                      "color": "#FFFFFF",
                      "fontSize": 26,
                      "fontWeight": 800,
                      "lines": 2
                    }
                  },
                  {
                    "type": "text",
                    "field": "genres",
                    "when": {
                      "field": "genres"
                    },
                    "style": {
                      "color": "#D8D2F5",
                      "fontSize": 12,
                      "fontWeight": 700,
                      "lines": 1
                    }
                  },
                  {
                    "type": "row",
                    "style": {
                      "gap": 8,
                      "align": "center",
                      "wrap": "nowrap"
                    },
                    "children": [
                      {
                        "type": "action",
                        "text": "Watch now",
                        "action": "play",
                        "style": {
                          "background": "#A78BFA",
                          "color": "#15121F",
                          "minHeight": 44,
                          "radius": 6,
                          "fontWeight": 800,
                          "grow": 1,
                          "justify": "center"
                        }
                      },
                      {
                        "type": "action",
                        "text": "Info",
                        "action": "details",
                        "style": {
                          "background": "#FFFFFF1F",
                          "color": "#FFFFFF",
                          "minHeight": 44,
                          "radius": 6,
                          "fontWeight": 700
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "rows": {
          "defaults": {
            "width": 108,
            "gap": 8,
            "spacing": 24,
            "radius": 4,
            "titleSize": 15
          },
          "byId": {
            "continue": {
              "layout": "carousel",
              "width": 224,
              "aspect": "landscape",
              "radius": 4
            }
          }
        },
        "detail": {
          "layout": "stack",
          "posterWidth": 118,
          "bannerHeight": 26,
          "cta": "large",
          "tabs": "underline",
          "episodes": {
            "placement": "tab",
            "arrangement": "list"
          }
        }
      }
    }
  }
}
