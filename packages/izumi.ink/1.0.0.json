{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.ink",
  "name": "Ink",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "A quiet, compact browsing layout with no hero and a wrapping poster grid. Continue Watching keeps its carousel.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "230 15% 6%",
      "foreground": "220 20% 96%",
      "muted": "230 14% 16%",
      "mutedForeground": "225 12% 70%",
      "primary": "220 20% 96%",
      "primaryForeground": "230 15% 6%",
      "secondary": "230 14% 16%",
      "secondaryForeground": "220 20% 96%",
      "accent": "230 15% 22%",
      "accentForeground": "220 20% 96%",
      "border": "230 10% 28%",
      "input": "230 10% 28%",
      "ring": "227 30% 68%",
      "card": "230 15% 9%",
      "cardForeground": "220 20% 96%",
      "theme": "227 30% 68%"
    },
    "radius": 0.25,
    "font": "mono",
    "fontScale": 0.95,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "hero": {
        "hidden": true
      },
      "rows": {
        "defaults": {
          "layout": "grid",
          "width": 128,
          "gap": 12,
          "spacing": 28,
          "radius": 4,
          "titleSize": 16
        },
        "byId": {
          "continue": {
            "layout": "carousel",
            "width": 264,
            "aspect": "landscape"
          }
        }
      }
    }
  }
}
