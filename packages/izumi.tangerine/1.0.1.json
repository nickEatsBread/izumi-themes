{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 2,
  "id": "izumi.tangerine",
  "name": "Tangerine",
  "version": "1.0.1",
  "author": "Izumi",
  "description": "Streaming-service orange on charcoal with square corners. A compact top bar, a tall featured backdrop with a bold Start Watching button, tight poster rows, and a stacked series page whose episodes are a grid of 16:9 stills with numbered titles.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "228 11% 9%",
      "foreground": "0 0% 100%",
      "muted": "225 8% 14%",
      "mutedForeground": "220 6% 63%",
      "primary": "24 90% 54%",
      "primaryForeground": "0 0% 0%",
      "secondary": "225 8% 14%",
      "secondaryForeground": "0 0% 100%",
      "accent": "225 8% 18%",
      "accentForeground": "0 0% 100%",
      "border": "225 8% 20%",
      "input": "225 8% 14%",
      "ring": "24 90% 54%",
      "card": "225 8% 12%",
      "cardForeground": "0 0% 100%",
      "theme": "24 90% 54%"
    },
    "radius": 0.25,
    "font": "system",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": {
        "nav": "top",
        "compact": true,
        "overlay": "none",
        "press": "none"
      },
      "player": {
        "seekbarHeight": 4,
        "seekbarColor": "theme"
      },
      "hero": {
        "height": 60,
        "mobileHeight": 50,
        "rotate": true,
        "interval": 10,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "style": {
            "minHeight": 380
          },
          "children": [
            {
              "type": "artwork",
              "artwork": "backdrop",
              "style": {
                "anchor": "fill",
                "fit": "cover"
              }
            },
            {
              "type": "stack",
              "style": {
                "anchor": "bottom-start",
                "padding": 40,
                "gap": 12,
                "maxWidth": 760
              },
              "children": [
                {
                  "type": "text",
                  "field": "title",
                  "style": {
                    "color": "#FFFFFF",
                    "fontSize": 46,
                    "fontWeight": 900,
                    "lines": 2
                  }
                },
                {
                  "type": "row",
                  "style": {
                    "gap": 8,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "text",
                      "field": "score",
                      "when": {
                        "field": "score"
                      },
                      "style": {
                        "color": "#F47521",
                        "fontSize": 14,
                        "fontWeight": 800
                      }
                    },
                    {
                      "type": "text",
                      "field": "format",
                      "when": {
                        "field": "format"
                      },
                      "style": {
                        "color": "#DADADA",
                        "fontSize": 14,
                        "fontWeight": 700
                      }
                    },
                    {
                      "type": "text",
                      "field": "episodeCount",
                      "when": {
                        "field": "episodeCount"
                      },
                      "style": {
                        "color": "#DADADA",
                        "fontSize": 14
                      }
                    },
                    {
                      "type": "text",
                      "text": "Episodes",
                      "when": {
                        "field": "episodeCount"
                      },
                      "style": {
                        "color": "#DADADA",
                        "fontSize": 14
                      }
                    },
                    {
                      "type": "text",
                      "field": "genres",
                      "when": {
                        "field": "genres"
                      },
                      "style": {
                        "color": "#A0A0A0",
                        "fontSize": 14
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "field": "description",
                  "when": {
                    "field": "description"
                  },
                  "style": {
                    "color": "#DADADA",
                    "fontSize": 15,
                    "maxWidth": 620,
                    "lines": 2
                  }
                },
                {
                  "type": "row",
                  "style": {
                    "gap": 10,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "action",
                      "action": "play",
                      "text": "Start Watching",
                      "style": {
                        "background": "#F47521",
                        "color": "#000000",
                        "minHeight": 44,
                        "radius": 2,
                        "fontWeight": 900
                      }
                    },
                    {
                      "type": "action",
                      "action": "list",
                      "text": "Add to Watchlist",
                      "style": {
                        "background": "transparent",
                        "color": "#F47521",
                        "minHeight": 44,
                        "radius": 2,
                        "fontWeight": 800
                      }
                    },
                    {
                      "type": "action",
                      "action": "details",
                      "text": "Details",
                      "style": {
                        "background": "#FFFFFF1A",
                        "color": "#FFFFFF",
                        "minHeight": 44,
                        "radius": 2,
                        "fontWeight": 800
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "rows": {
        "defaults": {
          "layout": "carousel",
          "width": 168,
          "gap": 16,
          "spacing": 36,
          "radius": 2,
          "titleSize": 18,
          "aspect": "poster"
        },
        "byId": {
          "continue": {
            "layout": "carousel",
            "width": 300,
            "aspect": "landscape",
            "radius": 2,
            "gap": 16
          }
        }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": {
            "gap": 8
          },
          "children": [
            {
              "type": "artwork",
              "artwork": "poster",
              "style": {
                "aspect": "2 / 3",
                "radius": 2,
                "fit": "cover"
              }
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 14,
                "lines": 2
              }
            },
            {
              "type": "row",
              "style": {
                "gap": 6,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "field": "format",
                  "when": {
                    "field": "format"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                },
                {
                  "type": "text",
                  "field": "status",
                  "when": {
                    "field": "status"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                }
              ]
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": {
            "gap": 8
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "still",
                  "style": {
                    "aspect": "16 / 9",
                    "radius": 2,
                    "fit": "cover"
                  }
                },
                {
                  "type": "text",
                  "field": "duration",
                  "when": {
                    "field": "duration"
                  },
                  "style": {
                    "anchor": "bottom-end",
                    "color": "#FFFFFF",
                    "fontSize": 11,
                    "fontWeight": 700,
                    "background": "#000000CC",
                    "radius": 2,
                    "padding": 4
                  }
                },
                {
                  "type": "meter",
                  "field": "progress",
                  "when": {
                    "field": "progress"
                  },
                  "style": {
                    "anchor": "bottom-start",
                    "minHeight": 4,
                    "background": "#FFFFFF33"
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 14,
                "lines": 1
              }
            },
            {
              "type": "row",
              "style": {
                "gap": 6,
                "align": "center",
                "wrap": "nowrap"
              },
              "children": [
                {
                  "type": "text",
                  "field": "episodeNumber",
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12,
                    "fontWeight": 700
                  }
                },
                {
                  "type": "text",
                  "text": "-",
                  "when": {
                    "field": "episodeTitle"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                },
                {
                  "type": "text",
                  "field": "episodeTitle",
                  "when": {
                    "field": "episodeTitle"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12,
                    "lines": 1
                  }
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "stack",
        "bannerHidden": false,
        "posterWidth": 200,
        "bannerHeight": 34,
        "cta": "large",
        "episodes": {
          "placement": "tab",
          "arrangement": "grid",
          "hover": "none",
          "order": "tabs",
          "search": true,
          "card": {
            "type": "stack",
            "style": {
              "gap": 0
            },
            "children": [
              {
                "type": "overlay",
                "children": [
                  {
                    "type": "artwork",
                    "artwork": "still",
                    "style": {
                      "aspect": "16 / 9",
                      "radius": 2,
                      "fit": "cover"
                    }
                  },
                  {
                    "type": "text",
                    "field": "duration",
                    "when": {
                      "field": "duration"
                    },
                    "style": {
                      "anchor": "bottom-end",
                      "color": "#FFFFFF",
                      "fontSize": 11,
                      "fontWeight": 700,
                      "background": "#000000CC",
                      "radius": 2,
                      "padding": 4
                    }
                  },
                  {
                    "type": "meter",
                    "field": "progress",
                    "when": {
                      "field": "progress"
                    },
                    "style": {
                      "anchor": "bottom-start",
                      "minHeight": 4,
                      "background": "#FFFFFF33"
                    }
                  }
                ]
              },
              {
                "type": "stack",
                "style": {
                  "padding": 10,
                  "gap": 8
                },
                "children": [
                  {
                    "type": "row",
                    "style": {
                      "gap": 6,
                      "align": "center",
                      "wrap": "nowrap"
                    },
                    "children": [
                      {
                        "type": "text",
                        "field": "episodeNumber",
                        "style": {
                          "fontWeight": 800,
                          "fontSize": 14,
                          "shrink": 0
                        }
                      },
                      {
                        "type": "text",
                        "text": "-",
                        "style": {
                          "color": "muted-foreground",
                          "fontSize": 14
                        }
                      },
                      {
                        "type": "text",
                        "field": "episodeTitle",
                        "style": {
                          "fontWeight": 800,
                          "fontSize": 14,
                          "lines": 1,
                          "grow": 1
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "field": "description",
                    "when": {
                      "field": "description"
                    },
                    "style": {
                      "color": "muted-foreground",
                      "fontSize": 12,
                      "lines": 2
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "mobile": {
        "hero": {
          "height": 50
        },
        "rows": {
          "defaults": {
            "width": 120,
            "gap": 10,
            "spacing": 26,
            "radius": 2,
            "titleSize": 17
          },
          "byId": {
            "continue": {
              "layout": "carousel",
              "width": 236,
              "aspect": "landscape",
              "radius": 2,
              "gap": 10
            }
          }
        },
        "detail": {
          "posterWidth": 120,
          "bannerHeight": 28,
          "episodes": {
            "placement": "tab",
            "arrangement": "list"
          }
        }
      }
    }
  }
}
