    "css": "/* Saffron — the Crunchyroll look (docs/theme-references/crunchyroll.md): black, DM Sans, one orange, square corners. */\n\n/* Header: the #272727 bar with 16 px grey text tiles; an open tile turns #151515. */\n[data-slot=\"nav.top\"] { background: #272727 !important; border: 0 !important; }\n[data-slot=\"nav.top\"] > [data-part=\"nav.item\"] { height: 44px; padding: 0 16px; border-radius: 0 !important; background: transparent; color: #bbb !important; font-size: 16px; font-weight: 400; }\n[data-slot=\"nav.top\"] > [data-part=\"nav.item\"]:hover, [data-slot=\"nav.top\"] > [data-part=\"nav.item\"][data-active] { background: transparent !important; color: #fff !important; }\n[data-slot=\"nav.top\"] > [data-part=\"nav.item\"][data-variant=\"menu\"][data-active] { background: #151515 !important; }\n\n/* Categories: a #151515 panel — browse links on the left, then GENRES over three columns. */\n[data-slot=\"nav.categories\"] { border: 0 !important; border-radius: 0 !important; background: #151515 !important; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6) !important; }\n[data-slot=\"nav.categories\"] > div { border-color: #2a2a2a !important; }\n[data-part=\"nav.categories.link\"] { display: flex; align-items: center; min-height: 44px; padding: 12px 16px !important; color: #f2f2f2 !important; font-size: 16px !important; }\n[data-part=\"nav.categories.link\"][data-variant=\"genre\"] { width: 200px !important; color: #bbb !important; font-size: 14px !important; }\n[data-part=\"nav.categories.link\"]:hover { background: #23252b !important; color: #fff !important; }\n[data-part=\"nav.categories.heading\"] { padding: 13px 16px !important; color: #8c8c8c !important; font-size: 12px !important; font-weight: 700 !important; letter-spacing: -0.36px !important; }\n\n/* Hero: 16:9 key art that fades to black at the bottom and from the left, running under the first row. */\n[data-part=\"saffron.hero\"]::after {\n  background: linear-gradient(rgba(0, 0, 0, 0) 50%, #000 100%), linear-gradient(to right, rgba(0, 0, 0, 0.85) 0, rgba(0, 0, 0, 0.5) 30%, rgba(0, 0, 0, 0) 55%) !important;\n}\n[data-part=\"saffron.info\"] { padding-bottom: calc(56px + var(--hero-bleed, 0px)) !important; }\n[data-part=\"saffron.logo\"] { margin-bottom: 0; }\n[data-part=\"saffron.logo\"] img { object-position: left bottom; }\n[data-part=\"saffron.title\"] { letter-spacing: -1.02px; line-height: 1.15; text-shadow: none !important; }\n[data-part=\"saffron.meta\"] { margin: 20px 0 8px; line-height: 20px; }\n[data-part=\"saffron.age\"] { height: 20px; padding: 0 6px; border-radius: 2px; background: #4a4e58; color: #dadada; line-height: 20px; }\n[data-part=\"saffron.sep\"] { width: 4px; height: 4px; margin: 0 6px; background: #8c8c8c; font-size: 0 !important; line-height: 0; }\n[data-part=\"saffron.sep\"]:first-child { display: none; }\n[data-part=\"saffron.synopsis\"] { max-width: 466px; margin-bottom: 20px; line-height: 22px; }\n[data-part=\"saffron.actions\"] { margin-top: 4px; }\n[data-part=\"saffron.play\"] { height: 40px; padding: 0 16px !important; gap: 6px !important; border-radius: 0 !important; text-transform: uppercase; }\n[data-part=\"saffron.more\"] { width: 40px; height: 40px; padding: 0 !important; justify-content: center; border-radius: 0 !important; box-shadow: inset 0 0 0 2px #ff640a; }\n\n/* Slide markers: 24×8 white pills, the current one 48 wide and filling with orange; past ones stay empty. */\n[data-slot=\"home.hero\"] [data-part=\"hero.indicator\"] { gap: 8px !important; left: 64px !important; }\n[data-part=\"hero.dot.track\"] { width: 24px !important; height: 8px !important; border-radius: 4px !important; background: rgba(255, 255, 255, 0.5) !important; }\n[data-part=\"hero.dot\"][data-active] [data-part=\"hero.dot.track\"] { width: 48px !important; }\n[data-part=\"hero.dot.fill\"] { border-radius: 4px; }\n\n/* Rows: 28 px bold headings, grey uppercase \"view all\" links. */\n[data-part=\"row.title\"], [data-part=\"block.title\"] { font-weight: 700; letter-spacing: -0.5px; color: #fff; }\n@media (min-width: 641px) { [data-part=\"row.title\"], [data-part=\"block.title\"] { font-size: 28px !important; line-height: 36px; } }\n[data-part=\"row.more\"] { flex-shrink: 0; color: #8c8c8c !important; font-size: 14px; font-weight: 700; text-transform: uppercase; white-space: nowrap; opacity: 1 !important; }\n@media (max-width: 640px) { [data-part=\"row.more\"] { font-size: 12px; } }\n/* The page gutter matches the hero content: 64 px on desktop. */\n@media (min-width: 1024px) { [data-part=\"row.header\"], [data-part=\"row.track\"] { padding-left: 64px !important; padding-right: 64px !important; } }\n\n/* Poster cards: square art, a 14 px bold title 13 px below it and a grey line. */\n[data-part=\"saffron.poster\"] img { transform: none !important; }\n[data-part=\"saffron.card-title\"] { margin-top: 13px; letter-spacing: -0.42px; line-height: 20px; }\n[data-part=\"saffron.card-meta\"] { line-height: 20px; }\n/* The hover panel: a dark sheet over the art with the title, rating, episodes and synopsis. */\n[data-part=\"saffron.hover\"] { background: rgba(20, 21, 25, 0.94); opacity: 0; transition: opacity 0.15s ease-out; }\n[data-part=\"card\"]:hover [data-part=\"saffron.hover\"], [data-part=\"card\"]:focus-within [data-part=\"saffron.hover\"] { opacity: 1; }\n\n/* Continue Watching: orange progress on a dark track, the \"21m left\" chip, small grey series name, \"E1 - Title\". */\n[data-part=\"saffron.cw-bar\"] { min-height: 4px !important; border-radius: 0 !important; background: rgba(0, 0, 0, 0.6) !important; }\n[data-part=\"saffron.cw-bar\"] > span { background: #ff640a !important; }\n[data-part=\"saffron.cw-left\"], [data-part=\"saffron.ep-duration\"] { margin: 0 8px 12px 0; padding: 3px 5px; background: rgba(0, 0, 0, 0.6); line-height: 18px; }\n[data-part=\"saffron.cw-series\"] { margin-top: 10px; text-transform: uppercase; letter-spacing: -0.3px; line-height: 14px; }\n[data-part=\"saffron.cw-ep\"] { display: block !important; max-height: 44px; margin-top: 2px; overflow: hidden; line-height: 22px; letter-spacing: -0.48px; }\n[data-part=\"saffron.cw-ep\"] > * { display: inline !important; }\n\n/* Series page: key art with the logo, meta line and rating over its lower left, orange square buttons. */\n[data-slot=\"detail\"][data-layout=\"overlay\"][data-variant=\"desktop\"] { min-height: min(46vw, 82vh) !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.backdrop\"] { object-position: center top !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"][data-variant=\"desktop\"] [data-part=\"detail.body\"] { min-height: min(46vw, 82vh) !important; justify-content: flex-end !important; gap: 0 !important; max-width: 760px !important; padding: 0 64px 36px !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.alt-title\"],\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.studio\"],\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.meta\"] { display: none !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.title\"] { order: 1; font-size: 34px !important; font-weight: 700 !important; letter-spacing: -1.02px; line-height: 1.15 !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.header\"] { order: 2; margin-top: 16px; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.rating\"] { order: 3; margin-top: 12px !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.actions\"] { order: 4; margin-top: 20px; gap: 10px !important; }\n[data-slot=\"detail\"][data-layout=\"overlay\"] [data-part=\"detail.synopsis\"] { order: 5; -webkit-line-clamp: 4 !important; max-width: 714px; margin-top: 24px; color: #fff !important; font-size: 16px !important; line-height: 22px !important; }\n[data-part=\"detail.logo\"] { max-width: 342px !important; max-height: 182px !important; }\n[data-part=\"saffron.detail-meta\"] { line-height: 20px; }\n[data-part=\"saffron.detail-meta\"] [data-part=\"saffron.genres\"] { color: #fff !important; text-decoration: underline; text-underline-offset: 3px; }\n[data-slot=\"detail\"] [data-part=\"button\"][data-variant=\"primary\"] { height: 40px; padding: 0 16px !important; border-radius: 0 !important; background: #ff640a !important; color: #000 !important; font-size: 14px; font-weight: 700; text-transform: uppercase; }\n[data-slot=\"detail\"] [data-part=\"button\"][data-variant=\"secondary\"] { width: 40px !important; height: 40px !important; border-radius: 0 !important; background: transparent !important; box-shadow: inset 0 0 0 2px #ff640a; color: #ff640a !important; }\n[data-slot=\"detail\"] [data-part=\"tab\"][data-active] { color: #fff; }\n[data-slot=\"detail\"] [data-part=\"tab\"][data-active] > span { background: #ff640a; }\n\n/* Episodes: the Continue Watching card, square, no zoom on hover. */\n[data-part=\"saffron.ep-art\"] img { transform: none !important; }\n[data-slot=\"detail.episodes\"] [data-part=\"episode\"][data-variant=\"template\"] { border-radius: 0 !important; background: transparent !important; }\n[data-slot=\"detail.episodes\"] [data-part=\"episode\"][data-variant=\"template\"]:hover [data-part=\"saffron.cw-ep\"] { color: #fff; text-decoration: underline; text-underline-offset: 3px; }\n\n/* Episodes toolbar: the season picker at the left, \"≡ OLDEST\" and \"⋮ OPTIONS\" in grey capitals at the right. */\n[data-slot=\"episodes.toolbar\"] { margin-bottom: 16px; }\n[data-part=\"episodes.heading\"] { font-size: 20px !important; font-weight: 700 !important; }\n[data-part=\"episodes.count\"] { color: #8c8c8c !important; }\n[data-part=\"episodes.sort\"], [data-part=\"episodes.more\"] { height: 36px !important; width: auto !important; gap: 6px; padding: 0 8px !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; color: #8c8c8c !important; font-size: 14px !important; font-weight: 700 !important; text-transform: uppercase; }\n[data-part=\"episodes.sort\"]:hover, [data-part=\"episodes.more\"]:hover { color: #fff !important; }\n[data-part=\"episodes.more\"]::after { content: \"Options\"; }\n[data-part=\"episodes.menu\"] { border: 0 !important; border-radius: 0 !important; background: #23252b !important; }\n[data-part=\"episodes.more\"] { display: inline-flex !important; align-items: center; }\n[data-part=\"season.toggle\"] { height: 44px; font-size: 20px !important; font-weight: 700 !important; }\n\n/* Below the episodes: More like this, related titles, cast and details stacked under row-style headings. */\n[data-part=\"detail.section-title\"] { margin: 40px 0 16px; color: #fff; font-size: 28px !important; font-weight: 700 !important; line-height: 36px; letter-spacing: -0.5px; }\n@media (max-width: 640px) { [data-part=\"detail.section-title\"] { font-size: 20px !important; line-height: 26px; } }\n\n/* Phone series page: centred logo, meta and rating over the art, then a full-width orange button. */\n@media (max-width: 640px) {\n  [data-slot=\"detail\"][data-layout=\"overlay\"][data-variant=\"phone\"] [data-part=\"detail.body\"] { align-items: center !important; gap: 0 !important; }\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"detail.logo\"] { margin: 0 auto; object-position: center bottom !important; }\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"detail.header\"] { text-align: center; }\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"saffron.detail-meta\"], [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"saffron.detail-rating\"] { justify-content: center; }\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"detail.body\"] > [data-part=\"button\"][data-variant=\"primary\"] { order: 4; width: 100% !important; margin-top: 20px; justify-content: center; }\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"detail.synopsis\"] { align-self: stretch; text-align: left; }\n  /* The art stays at the top and fades out, so the text below sits on black as in the app. */\n  [data-slot=\"detail\"][data-variant=\"phone\"] [data-part=\"detail.backdrop\"] { height: 64% !important; -webkit-mask-image: linear-gradient(#000 50%, transparent); mask-image: linear-gradient(#000 50%, transparent); }\n}\n"
  }
