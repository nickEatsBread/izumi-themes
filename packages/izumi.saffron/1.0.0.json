                },
                "children": [
                  {
                    "type": "text",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": 700,
                      "color": "#FFFFFF"
                    },
                    "field": "episodeNumber"
                  },
                  {
                    "type": "text",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": 700,
                      "color": "#FFFFFF"
                    },
                    "text": " - ",
