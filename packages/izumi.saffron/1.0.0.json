{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 3,
  "id": "izumi.saffron",
  "name": "Saffron",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "Crunchyroll look: black and orange DM Sans, a key-art carousel with title logos, a Categories menu and episode grids.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 0% 0%",
      "foreground": "0 0% 100%",
      "muted": "0 0% 15%",
      "mutedForeground": "0 0% 55%",
      "primary": "22 100% 52%",
      "primaryForeground": "0 0% 0%",
      "secondary": "0 0% 15%",
      "secondaryForeground": "0 0% 100%",
      "accent": "0 0% 8%",
      "accentForeground": "0 0% 100%",
      "border": "0 0% 20%",
      "input": "0 0% 15%",
      "ring": "22 100% 52%",
      "card": "0 0% 8%",
      "cardForeground": "0 0% 100%",
      "theme": "22 100% 52%"
    },
    "radius": 0,
    "font": "system",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "fonts": {
      "ui": "dm-sans",
      "heading": "dm-sans",
      "display": "dm-sans"
    },
    "presentation": {
      "density": "comfortable",
      "trueBlack": true,
      "cardPreview": "none",
      "shell": {
        "nav": "top",
        "compact": true,
        "top": {
          "labels": "text",
          "search": "icon",
          "menu": "none",
          "brand": "start",
          "categories": true
        },
        "bottomNav": {
          "style": "bar",
          "labels": "always",
          "indicator": "line",
          "height": 60,
          "iconSize": 22,
          "background": "#272727",
          "activeColor": "#FF640A",
          "inactiveColor": "#BBBBBB",
          "blur": false,
          "border": false,
          "hide": "never"
        }
      },
      "hero": {
        "scale": "wide",
        "bleed": 300,
        "height": 70,
        "mobileHeight": 72,
        "rotate": true,
        "interval": 8,
        "indicator": {
          "style": "bars",
          "position": "start",
          "color": "#FF640A",
          "past": "empty"
        },
        "template": {
          "type": "overlay",
          "part": "saffron.hero",
          "children": [
            {
              "type": "artwork",
              "artwork": "keyart",
              "part": "saffron.art",
              "when": {
                "field": "keyart"
              },
              "style": {
                "anchor": "fill",
                "fit": "cover"
              }
            },
            {
              "type": "artwork",
              "artwork": "backdrop",
              "part": "saffron.art",
              "when": {
                "field": "keyart",
                "absent": true
              },
              "style": {
                "anchor": "fill",
                "fit": "cover"
              }
            },
            {
              "type": "stack",
              "part": "saffron.info",
              "style": {
                "anchor": "bottom-start",
                "align": "start",
                "gap": 0,
                "padding": 64,
                "width": 44
              },
              "children": [
                {
                  "type": "artwork",
                  "artwork": "logo",
                  "part": "saffron.logo",
                  "when": {
                    "field": "logo"
                  },
                  "style": {
                    "fit": "contain",
                    "maxWidth": 342,
                    "aspect": "2 / 1"
                  }
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 34,
                    "fontWeight": 700,
                    "lines": 2,
                    "color": "#FFFFFF"
                  },
                  "field": "title",
                  "when": {
                    "field": "logo",
                    "absent": true
                  },
                  "part": "saffron.title"
                },
                {
                  "type": "row",
                  "part": "saffron.meta",
                  "style": {
                    "gap": 0,
                    "align": "center",
                    "wrap": "wrap"
                  },
                  "children": [
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 12,
                        "fontWeight": 700
                      },
                      "field": "ageRating",
                      "when": {
                        "field": "ageRating"
                      },
                      "part": "saffron.age"
                    },
                    {
                      "type": "text",
                      "text": " ",
                      "part": "saffron.sep",
                      "when": {
                        "field": "audio"
                      },
                      "style": {
                        "fontSize": 10,
                        "fontWeight": 400
                      }
                    },
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 400,
                        "color": "#8C8C8C"
                      },
                      "field": "audio",
                      "when": {
                        "field": "audio"
                      },
                      "part": "saffron.audio"
                    },
                    {
                      "type": "text",
                      "text": " ",
                      "part": "saffron.sep",
                      "when": {
                        "field": "genres"
                      },
                      "style": {
                        "fontSize": 10,
                        "fontWeight": 400
                      }
                    },
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 400,
                        "lines": 1,
                        "color": "#8C8C8C"
                      },
                      "field": "genres",
                      "when": {
                        "field": "genres"
                      },
                      "part": "saffron.genres"
                    }
                  ]
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 16,
                    "fontWeight": 400,
                    "lines": 4,
                    "color": "#BBBBBB"
                  },
                  "field": "description",
                  "part": "saffron.synopsis"
                },
                {
                  "type": "row",
                  "part": "saffron.actions",
                  "style": {
                    "gap": 10,
                    "align": "center",
                    "wrap": "nowrap"
                  },
                  "children": [
                    {
                      "type": "action",
                      "action": "play",
                      "text": "START WATCHING",
                      "part": "saffron.play",
                      "style": {
                        "minHeight": 40,
                        "fontSize": 14,
                        "fontWeight": 700,
                        "color": "#000000",
                        "background": "#FF640A"
                      }
                    },
                    {
                      "type": "action",
                      "action": "details",
                      "icon": "info",
                      "part": "saffron.more",
                      "style": {
                        "minHeight": 40,
                        "fontSize": 22,
                        "fontWeight": 700,
                        "color": "#FF640A",
                        "background": "transparent"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "rows": {
        "defaults": {
          "width": 250,
          "gap": 18,
          "titleSize": 28,
          "heading": {
            "weight": 700,
            "viewMore": "text"
          }
        },
        "byId": {
          "continue": {
            "width": 267
          }
        }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "part": "saffron.card",
          "style": {
            "gap": 0
          },
          "children": [
            {
              "type": "overlay",
              "part": "saffron.poster",
              "style": {
                "aspect": "2 / 3"
              },
              "children": [
                {
                  "type": "artwork",
                  "artwork": "poster",
                  "style": {
                    "anchor": "fill",
                    "fit": "cover",
                    "radius": 0
                  }
                },
                {
                  "type": "stack",
                  "part": "saffron.hover",
                  "style": {
                    "anchor": "fill",
                    "gap": 6,
                    "padding": 12,
                    "align": "start"
                  },
                  "children": [
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 700,
                        "lines": 3,
                        "color": "#FFFFFF"
                      },
                      "field": "title"
                    },
                    {
                      "type": "row",
                      "style": {
                        "gap": 4,
                        "align": "center"
                      },
                      "when": {
                        "field": "score"
                      },
                      "children": [
                        {
                          "type": "text",
                          "style": {
                            "fontSize": 14,
                            "fontWeight": 400,
                            "color": "#BBBBBB"
                          },
                          "field": "score"
                        },
                        {
                          "type": "text",
                          "style": {
                            "fontSize": 12,
                            "fontWeight": 400,
                            "color": "#BBBBBB"
                          },
                          "text": "★"
                        },
                        {
                          "type": "row",
                          "when": {
                            "field": "members"
                          },
                          "style": {
                            "gap": 0
                          },
                          "children": [
                            {
                              "type": "text",
                              "style": {
                                "fontSize": 14,
                                "fontWeight": 400,
                                "color": "#BBBBBB"
                              },
                              "text": "("
                            },
                            {
                              "type": "text",
                              "style": {
                                "fontSize": 14,
                                "fontWeight": 400,
                                "color": "#BBBBBB"
                              },
                              "field": "members",
                              "part": "saffron.members"
                            },
                            {
                              "type": "text",
                              "style": {
                                "fontSize": 14,
                                "fontWeight": 400,
                                "color": "#BBBBBB"
                              },
                              "text": ")"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "style": {
                        "gap": 4
                      },
                      "when": {
                        "field": "episodeCount"
                      },
                      "children": [
                        {
                          "type": "text",
                          "style": {
                            "fontSize": 14,
                            "fontWeight": 700,
                            "color": "#8C8C8C"
                          },
                          "field": "episodeCount"
                        },
                        {
                          "type": "text",
                          "style": {
                            "fontSize": 14,
                            "fontWeight": 700,
                            "color": "#8C8C8C"
                          },
                          "text": "Episodes"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 400,
                        "lines": 6,
                        "color": "#FFFFFF"
                      },
                      "field": "description",
                      "part": "saffron.hover-synopsis"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "style": {
                "fontSize": 14,
                "fontWeight": 700,
                "lines": 2,
                "color": "#FFFFFF"
              },
              "field": "title",
              "part": "saffron.card-title"
            },
            {
              "type": "text",
              "style": {
                "fontSize": 14,
                "fontWeight": 400,
                "lines": 1,
                "color": "#8C8C8C"
              },
              "field": "format",
              "when": {
                "field": "format"
              },
              "part": "saffron.card-meta"
            }
          ]
        },
        "continue": {
          "type": "stack",
          "part": "saffron.cw",
          "style": {
            "gap": 0
          },
          "children": [
            {
              "type": "overlay",
              "part": "saffron.cw-art",
              "style": {
                "aspect": "16 / 9"
              },
              "children": [
                {
                  "type": "artwork",
                  "artwork": "still",
                  "style": {
                    "anchor": "fill",
                    "fit": "cover",
                    "radius": 0
                  }
                },
                {
                  "type": "meter",
                  "field": "progress",
                  "part": "saffron.cw-bar",
                  "when": {
                    "field": "timeLeft"
                  },
                  "style": {
                    "anchor": "bottom-start"
                  }
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": 700,
                    "anchor": "bottom-end",
                    "color": "#FFFFFF"
                  },
                  "field": "timeLeft",
                  "when": {
                    "field": "timeLeft"
                  },
                  "part": "saffron.cw-left"
                }
              ]
            },
            {
              "type": "text",
              "style": {
                "fontSize": 10,
                "fontWeight": 700,
                "lines": 1,
                "color": "#8C8C8C"
              },
              "field": "title",
              "part": "saffron.cw-series"
            },
            {
              "type": "row",
              "part": "saffron.cw-ep",
              "style": {
                "gap": 0
              },
              "children": [
                {
                  "type": "text",
                  "style": {
                    "fontSize": 16,
                    "fontWeight": 700,
                    "color": "#FFFFFF"
                  },
                  "field": "episodeNumber"
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 16,
                    "fontWeight": 700,
                    "color": "#FFFFFF"
                  },
                  "text": " - ",
                  "when": {
                    "field": "episodeTitle"
                  }
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 16,
                    "fontWeight": 700,
                    "color": "#FFFFFF"
                  },
                  "field": "episodeTitle",
                  "when": {
                    "field": "episodeTitle"
                  }
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "overlay",
        "art": "keyart",
        "title": "logo",
        "header": {
          "type": "stack",
          "part": "saffron.detail-head",
          "style": {
            "gap": 10
          },
          "children": [
            {
              "type": "row",
              "part": "saffron.detail-meta",
              "style": {
                "gap": 0,
                "align": "center",
                "wrap": "wrap"
              },
              "children": [
                {
                  "type": "text",
                  "style": {
                    "fontSize": 12,
                    "fontWeight": 700
                  },
                  "field": "ageRating",
                  "when": {
                    "field": "ageRating"
                  },
                  "part": "saffron.age"
                },
                {
                  "type": "text",
                  "text": " ",
                  "part": "saffron.sep",
                  "when": {
                    "field": "audio"
                  },
                  "style": {
                    "fontSize": 10,
                    "fontWeight": 400
                  }
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": 400,
                    "color": "#8C8C8C"
                  },
                  "field": "audio",
                  "when": {
                    "field": "audio"
                  },
                  "part": "saffron.audio"
                },
                {
                  "type": "text",
                  "text": " ",
                  "part": "saffron.sep",
                  "when": {
                    "field": "genres"
                  },
                  "style": {
                    "fontSize": 10,
                    "fontWeight": 400
                  }
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": 400,
                    "lines": 1,
                    "color": "#8C8C8C"
                  },
                  "field": "genres",
                  "when": {
                    "field": "genres"
                  },
                  "part": "saffron.genres"
                }
              ]
            },
            {
              "type": "row",
              "part": "saffron.detail-rating",
              "when": {
                "field": "score"
              },
              "style": {
                "gap": 6,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": 700,
                    "color": "#BBBBBB"
                  },
                  "text": "Average Rating:"
                },
                {
                  "type": "text",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": 700,
                    "color": "#BBBBBB"
                  },
                  "field": "score"
                },
                {
                  "type": "row",
                  "when": {
                    "field": "members"
                  },
                  "style": {
                    "gap": 0
                  },
                  "children": [
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 700,
                        "color": "#BBBBBB"
                      },
                      "text": "("
                    },
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 700,
                        "color": "#BBBBBB"
                      },
                      "field": "members",
                      "part": "saffron.members"
                    },
                    {
                      "type": "text",
                      "style": {
                        "fontSize": 14,
                        "fontWeight": 700,
                        "color": "#BBBBBB"
                      },
                      "text": ")"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "sections": {
          "mode": "stack",
          "tabs": [
            "recommended",
            "relations",
            "characters",
            "overview"
          ],
          "labels": {
            "recommended": "more-like-this",
            "overview": "details"
          }
        },
        "tabs": "underline",
        "factsStyle": "table",
        "countdown": "compact",
        "episodes": {
          "placement": "below",
          "arrangement": "grid",
          "hover": "none",
          "card": {
            "type": "stack",
            "part": "saffron.ep",
            "style": {
              "gap": 0
            },
            "children": [
              {
                "type": "overlay",
                "part": "saffron.ep-art",
                "style": {
                  "aspect": "16 / 9"
                },
                "children": [
                  {
                    "type": "artwork",
                    "artwork": "still",
                    "style": {
                      "anchor": "fill",
                      "fit": "cover",
                      "radius": 0
