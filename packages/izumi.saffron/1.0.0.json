                      "field": "episodeTitle"
                    }
                  },
                  {
                    "type": "text",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": 700,
                      "color": "#FFFFFF"
                    },
                    "field": "episodeTitle",
                    "when": {
                      "field": "episodeTitle"
                    }
                  }
                ]
              }
            ]
          },
          "order": "flip",
          "toolbar": "header",
          "controls": [
            "sort"
          ],
          "seasons": "dropdown"
        }
