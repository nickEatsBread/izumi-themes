{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.blossom",
  "name": "Blossom",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "A phone-first Material You look in soft pink over violet-black, with very round corners, a mesh glow and Nunito. Home opens on a featured card that pairs the cover with the title, score and pill actions, then rounded poster rows and card-style resume stills. The series page shows chips for score, format, episodes and season with a thumbnail episode list. Desktop uses the same palette with a wider banner.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "270 20% 7%",
      "foreground": "280 20% 96%",
      "muted": "270 16% 13%",
      "mutedForeground": "275 14% 68%",
      "primary": "315 80% 76%",
      "primaryForeground": "290 40% 12%",
      "secondary": "270 16% 15%",
      "secondaryForeground": "280 20% 96%",
      "accent": "290 26% 22%",
      "accentForeground": "280 20% 96%",
      "border": "275 14% 22%",
      "input": "270 16% 15%",
      "ring": "315 80% 76%",
      "card": "270 18% 11%",
      "cardForeground": "280 20% 96%",
      "theme": "315 80% 72%"
    },
    "radius": 1.4,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "mesh",
    "backdropStrength": 0.3,
    "glassBlur": 24,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": { "nav": "sidebar", "compact": false, "overlay": "none", "press": "sink" },
      "player": { "seekbarHeight": 5, "seekbarColor": "theme" },
      "hero": {
        "height": 48,
        "mobileHeight": 52,
        "rotate": true,
        "interval": 11,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "row",
              "style": { "anchor": "bottom-start", "padding": 28, "gap": 22, "align": "end", "wrap": "nowrap" },
              "children": [
                { "type": "artwork", "artwork": "poster", "style": { "maxWidth": 160, "aspect": "2 / 3", "radius": 20, "fit": "cover" } },
                {
                  "type": "stack",
                  "style": { "gap": 8, "maxWidth": 560 },
                  "children": [
                    { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 34, "fontWeight": 900, "lines": 2 } },
                    {
                      "type": "row",
                      "style": { "gap": 8, "align": "center" },
                      "children": [
                        { "type": "row", "when": { "field": "score" }, "style": { "gap": 4, "align": "center", "background": "#F2A5DC", "radius": 20, "padding": 6 }, "children": [
                          { "type": "icon", "icon": "score", "style": { "fontSize": 13, "color": "#2A1030" } },
                          { "type": "text", "field": "score", "style": { "color": "#2A1030", "fontSize": 12, "fontWeight": 800 } }
                        ]},
                        { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "#FFFFFF", "fontSize": 12, "fontWeight": 700, "background": "#FFFFFF24", "radius": 20, "padding": 6 } },
                        { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "#FFFFFF", "fontSize": 12, "fontWeight": 700, "background": "#FFFFFF24", "radius": 20, "padding": 6 } }
                      ]
                    },
                    { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#EBE4F4", "fontSize": 14, "lines": 2 } },
                    {
                      "type": "row",
                      "style": { "gap": 10, "align": "center" },
                      "children": [
                        { "type": "action", "action": "play", "text": "Watch", "style": { "background": "#F2A5DC", "color": "#2A1030", "minHeight": 42, "radius": 28, "fontWeight": 800 } },
                        { "type": "action", "action": "list", "text": "Add to list", "style": { "background": "#FFFFFF1F", "color": "#FFFFFF", "minHeight": 42, "radius": 28, "fontWeight": 700 } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "rows": {
        "defaults": { "layout": "carousel", "width": 154, "gap": 16, "spacing": 32, "radius": 18, "titleSize": 19, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 300, "aspect": "landscape", "radius": 18, "gap": 16 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 18, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 13, "lines": 2 } }
          ]
        },
        "continue": {
          "type": "stack",
          "style": { "gap": 0, "background": "card", "radius": 18 },
          "children": [
            {
              "type": "overlay",
              "children": [
                { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 18, "fit": "cover" } },
                { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4, "background": "#FFFFFF33" } }
              ]
            },
            {
              "type": "stack",
              "style": { "padding": 12, "gap": 3 },
              "children": [
                { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14, "lines": 1 } },
                {
                  "type": "row",
                  "style": { "gap": 8, "align": "center" },
                  "children": [
                    { "type": "text", "field": "episodeNumber", "style": { "color": "theme", "fontSize": 12, "fontWeight": 800 } },
                    { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "color": "muted-foreground", "fontSize": 12, "lines": 1 } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "stack",
        "bannerHidden": false,
        "posterWidth": 200,
        "bannerHeight": 30,
        "cta": "large",
        "facts": {
          "type": "row",
          "style": { "gap": 8, "align": "center" },
          "children": [
            { "type": "row", "when": { "field": "score" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "score", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "score", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]},
            { "type": "row", "when": { "field": "format" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "format", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "format", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]},
            { "type": "row", "when": { "field": "episodeCount" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "episodes", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "episodeCount", "style": { "fontSize": 12, "fontWeight": 800 } },
              { "type": "text", "text": "eps", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]},
            { "type": "row", "when": { "field": "season" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "season", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "season", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]},
            { "type": "row", "when": { "field": "status" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "status", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "status", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]},
            { "type": "row", "when": { "field": "studio" }, "style": { "gap": 6, "align": "center", "background": "muted", "radius": 20, "padding": 8 }, "children": [
              { "type": "icon", "icon": "studio", "style": { "fontSize": 14, "color": "theme" } },
              { "type": "text", "field": "studio", "style": { "fontSize": 12, "fontWeight": 800 } }
            ]}
          ]
        },
        "episodes": {
          "placement": "tab",
          "arrangement": "list",
          "hover": "none",
          "order": "flip",
          "search": true,
          "card": {
            "type": "row",
            "style": { "gap": 12, "align": "center", "wrap": "nowrap", "padding": 8, "radius": 16, "background": "card" },
            "children": [
              {
                "type": "overlay",
                "style": { "width": 38, "shrink": 0 },
                "children": [
                  { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 12, "fit": "cover" } },
                  { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 3 } }
                ]
              },
              {
                "type": "stack",
                "style": { "grow": 1, "gap": 3 },
                "children": [
                  { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 14, "lines": 1 } },
                  {
                    "type": "row",
                    "style": { "gap": 8, "align": "center" },
                    "children": [
                      { "type": "text", "field": "episodeNumber", "style": { "color": "theme", "fontSize": 12, "fontWeight": 800 } },
                      { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 12 } },
                      { "type": "text", "field": "airDate", "when": { "field": "airDate" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "mobile": {
        "hero": {
          "height": 52,
          "template": {
            "type": "overlay",
            "children": [
              { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
              {
                "type": "row",
                "style": { "anchor": "bottom-start", "padding": 16, "gap": 14, "align": "end", "wrap": "nowrap", "width": 100 },
                "children": [
                  { "type": "artwork", "artwork": "poster", "style": { "maxWidth": 110, "aspect": "2 / 3", "radius": 16, "fit": "cover", "shrink": 0 } },
                  {
                    "type": "stack",
                    "style": { "gap": 6, "grow": 1 },
                    "children": [
                      { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 22, "fontWeight": 900, "lines": 2 } },
                      {
                        "type": "row",
                        "style": { "gap": 6, "align": "center" },
                        "children": [
                          { "type": "row", "when": { "field": "score" }, "style": { "gap": 4, "align": "center", "background": "#F2A5DC", "radius": 20, "padding": 5 }, "children": [
                            { "type": "icon", "icon": "score", "style": { "fontSize": 12, "color": "#2A1030" } },
                            { "type": "text", "field": "score", "style": { "color": "#2A1030", "fontSize": 11, "fontWeight": 800 } }
                          ]},
                          { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "#FFFFFF", "fontSize": 11, "fontWeight": 700, "background": "#FFFFFF24", "radius": 20, "padding": 5 } }
                        ]
                      },
                      {
                        "type": "row",
                        "style": { "gap": 8, "align": "center", "wrap": "nowrap" },
                        "children": [
                          { "type": "action", "action": "play", "text": "Watch", "style": { "background": "#F2A5DC", "color": "#2A1030", "minHeight": 40, "radius": 22, "fontWeight": 800, "grow": 1, "justify": "center" } },
                          { "type": "action", "action": "details", "text": "Info", "style": { "background": "#FFFFFF1F", "color": "#FFFFFF", "minHeight": 40, "radius": 22, "fontWeight": 700 } }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "rows": {
          "defaults": { "width": 116, "gap": 12, "spacing": 26, "radius": 16, "titleSize": 18 },
          "byId": { "continue": { "layout": "carousel", "width": 260, "aspect": "landscape", "radius": 16, "gap": 12 } }
        },
        "detail": { "layout": "stack", "posterWidth": 140, "bannerHeight": 30, "cta": "large", "episodes": { "placement": "tab", "arrangement": "list" } }
      }
    }
  }
}
