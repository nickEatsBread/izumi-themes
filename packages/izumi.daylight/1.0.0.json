{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 2,
  "id": "izumi.daylight",
  "name": "Daylight",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "The catalog’s light theme. A warm paper canvas, serif type and a coral accent. Top navigation, a featured backdrop with a paper caption card and an ink-dark Watch button, generously rounded poster rows with titles and years, and a split series page with a right-hand episode rail.",
  "design": {
    "tokens": {
      "scheme": "light",
      "background": "40 30% 97%",
      "foreground": "230 20% 12%",
      "muted": "40 22% 92%",
      "mutedForeground": "230 8% 42%",
      "primary": "230 20% 12%",
      "primaryForeground": "0 0% 100%",
      "secondary": "40 22% 90%",
      "secondaryForeground": "230 20% 12%",
      "accent": "40 26% 86%",
      "accentForeground": "230 20% 12%",
      "border": "40 14% 84%",
      "input": "40 22% 92%",
      "ring": "12 80% 55%",
      "card": "0 0% 100%",
      "cardForeground": "230 20% 12%",
      "theme": "12 80% 55%"
    },
    "radius": 0.9,
    "font": "serif",
    "fontScale": 1.02,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": {
        "nav": "top",
        "compact": false,
        "overlay": "none",
        "press": "sink"
      },
      "player": {
        "seekbarHeight": 4,
        "seekbarColor": "theme"
      },
      "hero": {
        "height": 50,
        "mobileHeight": 46,
        "rotate": true,
        "interval": 14,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            {
              "type": "artwork",
              "artwork": "backdrop",
              "style": {
                "anchor": "fill",
                "fit": "cover"
              }
            },
            {
              "type": "stack",
              "style": {
                "anchor": "bottom-start",
                "padding": 32,
                "gap": 0
              },
              "children": [
                {
                  "type": "stack",
                  "style": {
                    "padding": 22,
                    "gap": 10,
                    "maxWidth": 640,
                    "background": "#FBF8F3F0",
                    "radius": 16
                  },
                  "children": [
                    {
                      "type": "text",
                      "field": "genres",
                      "when": {
                        "field": "genres"
                      },
                      "style": {
                        "color": "#E0673E",
                        "fontSize": 13,
                        "fontWeight": 700
                      }
                    },
                    {
                      "type": "text",
                      "field": "title",
                      "style": {
                        "color": "#1B1D2A",
                        "fontSize": 40,
                        "fontWeight": 800,
                        "lines": 2
                      }
                    },
                    {
                      "type": "text",
                      "field": "description",
                      "when": {
                        "field": "description"
                      },
                      "style": {
                        "color": "#4A4D5C",
                        "fontSize": 15,
                        "lines": 3
                      }
                    },
                    {
                      "type": "row",
                      "style": {
                        "gap": 10,
                        "align": "center"
                      },
                      "children": [
                        {
                          "type": "action",
                          "action": "play",
                          "text": "Watch",
                          "style": {
                            "background": "#1B1D2A",
                            "color": "#FFFFFF",
                            "minHeight": 42,
                            "radius": 12,
                            "fontWeight": 800
                          }
                        },
                        {
                          "type": "action",
                          "action": "details",
                          "text": "Read more",
                          "style": {
                            "background": "#EDE7DD",
                            "color": "#1B1D2A",
                            "minHeight": 42,
                            "radius": 12,
                            "fontWeight": 800
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "rows": {
        "defaults": {
          "layout": "carousel",
          "width": 160,
          "gap": 18,
          "spacing": 40,
          "radius": 12,
          "titleSize": 21,
          "aspect": "poster"
        },
        "byId": {
          "continue": {
            "layout": "carousel",
            "width": 320,
            "aspect": "landscape",
            "radius": 12,
            "gap": 18
          }
        }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": {
            "gap": 8
          },
          "children": [
            {
              "type": "artwork",
              "artwork": "poster",
              "style": {
                "aspect": "2 / 3",
                "radius": 12,
                "fit": "cover"
              }
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 700,
                "fontSize": 14,
                "lines": 2
              }
            },
            {
              "type": "row",
              "style": {
                "gap": 6,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "field": "year",
                  "when": {
                    "field": "year"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                },
                {
                  "type": "text",
                  "field": "format",
                  "when": {
                    "field": "format"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12
                  }
                }
              ]
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": {
            "gap": 8
          },
          "children": [
            {
              "type": "overlay",
              "children": [
                {
                  "type": "artwork",
                  "artwork": "still",
                  "style": {
                    "aspect": "16 / 9",
                    "radius": 12,
                    "fit": "cover"
                  }
                },
                {
                  "type": "meter",
                  "field": "progress",
                  "when": {
                    "field": "progress"
                  },
                  "style": {
                    "anchor": "bottom-start",
                    "minHeight": 4,
                    "background": "#FFFFFF80"
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "title",
              "style": {
                "fontWeight": 800,
                "fontSize": 14,
                "lines": 1
              }
            },
            {
              "type": "row",
              "style": {
                "gap": 8,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "field": "episodeNumber",
                  "style": {
                    "color": "theme",
                    "fontSize": 12,
                    "fontWeight": 800
                  }
                },
                {
                  "type": "text",
                  "field": "episodeTitle",
                  "when": {
                    "field": "episodeTitle"
                  },
                  "style": {
                    "color": "muted-foreground",
                    "fontSize": 12,
                    "lines": 1
                  }
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "split",
        "bannerHidden": false,
        "posterWidth": 220,
        "bannerHeight": 30,
        "actionsFirst": false,
        "coverAlign": "start",
        "episodes": {
          "placement": "right",
          "arrangement": "list",
          "hover": "scale",
          "order": "tabs",
          "search": true,
          "card": {
            "type": "row",
            "style": {
              "gap": 12,
              "align": "center",
              "wrap": "nowrap",
              "padding": 8,
              "radius": 12,
              "background": "card"
            },
            "children": [
              {
                "type": "overlay",
                "style": {
                  "width": 38,
                  "shrink": 0
                },
                "children": [
                  {
                    "type": "artwork",
                    "artwork": "still",
                    "style": {
                      "aspect": "16 / 9",
                      "radius": 8,
                      "fit": "cover"
                    }
                  },
                  {
                    "type": "meter",
                    "field": "progress",
                    "when": {
                      "field": "progress"
                    },
                    "style": {
                      "anchor": "bottom-start",
                      "minHeight": 3
                    }
                  }
                ]
              },
              {
                "type": "stack",
                "style": {
                  "grow": 1,
                  "gap": 4
                },
                "children": [
                  {
                    "type": "text",
                    "field": "episodeNumber",
                    "style": {
                      "color": "theme",
                      "fontSize": 11,
                      "fontWeight": 800
                    }
                  },
                  {
                    "type": "text",
                    "field": "episodeTitle",
                    "style": {
                      "fontWeight": 700,
                      "fontSize": 14,
                      "lines": 2
                    }
                  },
                  {
                    "type": "text",
                    "field": "duration",
                    "when": {
                      "field": "duration"
                    },
                    "style": {
                      "color": "muted-foreground",
                      "fontSize": 12
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "mobile": {
        "hero": {
          "height": 44
        },
        "rows": {
          "defaults": {
            "width": 118,
            "gap": 12,
            "spacing": 28,
            "radius": 12,
            "titleSize": 18
          },
          "byId": {
            "continue": {
              "layout": "carousel",
              "width": 250,
              "aspect": "landscape",
              "radius": 12,
              "gap": 12
            }
          }
        },
        "detail": {
          "layout": "stack",
          "posterWidth": 130,
          "bannerHeight": 26,
          "episodes": {
            "placement": "tab",
            "arrangement": "list"
          }
        }
      }
    }
  }
}
