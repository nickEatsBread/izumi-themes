{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.cinema",
  "name": "Cinema",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "The familiar hero with a bold top-ten rank treatment, softer artwork corners and spacious rows.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "230 15% 6%",
      "foreground": "220 20% 96%",
      "muted": "230 14% 16%",
      "mutedForeground": "225 12% 70%",
      "primary": "220 20% 96%",
      "primaryForeground": "230 15% 6%",
      "secondary": "230 14% 16%",
      "secondaryForeground": "220 20% 96%",
      "accent": "230 15% 22%",
      "accentForeground": "220 20% 96%",
      "border": "230 10% 28%",
      "input": "230 10% 28%",
      "ring": "346 78% 60%",
      "card": "230 15% 9%",
      "cardForeground": "220 20% 96%",
      "theme": "346 78% 60%"
    },
    "radius": 0.6,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "hero": {
        "rank": {
          "type": "row",
          "when": {
            "field": "rank"
          },
          "style": {
            "align": "center",
            "gap": 8
          },
          "children": [
            {
              "type": "stack",
              "when": {
                "field": "rankPosition",
                "atMost": 10
              },
              "style": {
                "background": "#E50914",
                "color": "#FFFFFF",
                "padding": 6,
                "radius": 4,
                "align": "center"
              },
              "children": [
                {
                  "type": "text",
                  "text": "TOP",
                  "style": {
                    "fontSize": 10,
                    "fontWeight": 900
                  }
                },
                {
                  "type": "text",
                  "text": "10",
                  "style": {
                    "fontSize": 16,
                    "fontWeight": 900
                  }
                }
              ]
            },
            {
              "type": "text",
              "field": "rank",
              "style": {
                "color": "#FFFFFF",
                "fontSize": 16,
                "fontWeight": 900
              }
            }
          ]
        }
      },
      "rows": {
        "defaults": {
          "width": 168,
          "radius": 10,
          "gap": 16,
          "spacing": 40
        }
      }
    }
  }
}
