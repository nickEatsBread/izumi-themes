    "css": "/* Booth — the Miruro look (docs/theme-references/miruro.md): #080808, Geist, one lavender accent, 8 px corners, glass controls. */\n\n/* Wordmark: heavy blocky capitals, like the site's logo. */\n[data-part=\"brand.text\"] { font-weight: 900; font-size: 26px; letter-spacing: -0.5px; text-transform: uppercase; color: #e8e8e8; }\n@media (max-width: 640px) { [data-part=\"brand.mark\"] { display: none !important; } }\n\n/* Top bar: square 40 px controls and a centred 42 px search field on the surface colour. */\n[data-slot=\"nav.top\"] { background: #080808; }\n/* Destinations live in the drawer; the bar keeps the menu, the wordmark, search and the account controls. */\n[data-slot=\"nav.top\"] > [data-part=\"nav.item\"] { display: none; }\n[data-slot=\"nav.top\"] > [data-part=\"nav.menu\"],\n[data-slot=\"nav.top\"] > button:not([data-part]),\n[data-slot=\"nav.top\"] > a:not([data-part]) { width: 40px; height: 40px; border: 1px solid rgba(245, 245, 245, 0.1); border-radius: 8px; background: #141414; }\n[data-slot=\"nav.top\"] form:has([data-part=\"search.field\"]) { width: 100%; max-width: 463px; margin: 0 auto; }\n[data-slot=\"nav.top\"] [data-part=\"search.field\"] { height: 42px; border: 1px solid rgba(245, 245, 245, 0.1); border-radius: 8px; background: #141414; font-size: 13.6px; }\n\n/* Featured card: inset, 8 px corners, a darkening fade; glass chips and pills. */\n[data-slot=\"home.hero\"] { margin: 10px 10px 16px !important; width: auto !important; border-radius: 8px; overflow: hidden; }\n[data-part=\"booth.hero\"]::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(8, 8, 8, 0.92), rgba(8, 8, 8, 0.35) 55%, rgba(8, 8, 8, 0.15));\n  pointer-events: none;\n}\n[data-part=\"booth.hero\"] > * { z-index: 1; }\n[data-part=\"booth.glass\"], [data-part=\"booth.pill\"], [data-part=\"booth.nav\"], [data-part=\"booth.action\"] {\n  background: rgba(14, 14, 14, 0.3) !important;\n  border: 1px solid rgba(245, 245, 245, 0.1);\n  backdrop-filter: blur(6px);\n  color: #e8e8e8;\n}\n[data-part=\"booth.glass\"] { margin: 16px; padding: 8px 9.6px; }\n[data-part=\"booth.pager\"] { margin: 16px; }\n[data-part=\"booth.pager\"] [data-part=\"booth.glass\"] { margin: 0; }\n[data-part=\"booth.nav\"] { width: 38px; justify-content: center; padding: 0; }\n[data-part=\"booth.pill\"] { padding: 4.8px 9.6px; }\n[data-part=\"booth.action\"] { padding: 0 18px; gap: 8px; justify-content: center; }\n[data-part=\"booth.countdown\"] { text-transform: uppercase; }\n/* The title fills with the cover's colour fading to white, as on the site. */\n[data-part=\"booth.title\"] {\n  background-image: linear-gradient(45deg, color-mix(in srgb, rgb(var(--hero-ambient-rgb, 181 168 255)) 78%, #fff), #fff);\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  text-shadow: none !important;\n}\n\n/* Genre chip rail. */\n[data-slot=\"block.genre-chips\"] [data-part=\"chip\"] { padding: 8px 28px; border: 0; border-radius: 8px; background: #141414; color: #e8e8e8; font-size: 12.8px; font-weight: 500; white-space: nowrap; flex-shrink: 0; }\n[data-slot=\"block.genre-chips\"] :has(> [data-part=\"chip\"]) { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }\n\n/* Segmented NEWEST / POPULAR / TOP RATED strip and the pager. */\n[data-slot=\"block.tabbed-grid\"] [data-part=\"tabs\"] { display: flex; gap: 0; padding: 0; width: fit-content; max-width: 100%; border: 1px solid rgba(245, 245, 245, 0.1); border-radius: 8px; overflow: hidden; }\n[data-slot=\"block.tabbed-grid\"] [data-part=\"tab\"] { padding: 12px 20px; border-radius: 0; background: #141414; color: #e8e8e8; font-size: 12.8px; font-weight: 500; }\n[data-slot=\"block.tabbed-grid\"] [data-part=\"tab\"][data-active] { background: rgba(181, 168, 255, 0.25); color: #b5a8ff; }\n[data-slot=\"block.tabbed-grid\"] [data-part=\"tab\"] > span { display: none; }\n\n/* Poster cards: a status dot before the title, grey detail chips. */\n[data-part=\"booth.airing\"], [data-part=\"booth.finished\"] { flex: 0 0 8px; width: 8px; height: 8px; border-radius: 999px; }\n[data-part=\"booth.airing\"] { background: #a3e635; }\n[data-part=\"booth.finished\"] { background: #38bdf8; }\n[data-part=\"booth.detail\"] { padding: 3.2px; background: #141414; }\n\n/* TOP AIRING aside panel. */\n[data-slot=\"block.ranked-list\"] { padding: 12px; border: 1px solid rgba(245, 245, 245, 0.1); border-radius: 8px; background: #0e0e0e; }\n[data-slot=\"block.ranked-list\"] [data-part=\"block.title\"] { font-size: 17.6px; font-weight: 700; }\n\n/* Rows. */\n[data-part=\"row.title\"], [data-part=\"block.title\"] { font-weight: 700; color: #e8e8e8; }\n\n/* Series page: equal tabs in a hairline strip with a tinted active tab; facts as tinted value chips. */\n[data-slot=\"detail\"] [data-part=\"detail.poster\"] { border-radius: 8px; }\n[data-slot=\"detail\"] [data-part=\"tabs\"][data-variant=\"bar\"] { padding: 4px; border: 1px solid rgba(245, 245, 245, 0.1); border-radius: 8px; background: #0e0e0e; }\n[data-slot=\"detail\"] [data-part=\"tabs\"][data-variant=\"bar\"] [data-part=\"tab\"] { border-radius: 8px; background: #141414; color: #696969; font-weight: 400; font-size: 13.3px; }\n[data-slot=\"detail\"] [data-part=\"tabs\"][data-variant=\"bar\"] [data-part=\"tab\"][data-active] { background: rgba(181, 168, 255, 0.25); color: #b5a8ff; }\n[data-part=\"booth.tag\"] { padding: 2.4px 6.4px; background-color: #b5a8ff; color: #16132b; }\n/* The tag row replaces the facts line; the full facts stay in the Details tab. */\n[data-slot=\"detail\"] [data-part=\"detail.meta\"] { display: none; }\n[data-slot=\"detail\"] [data-part=\"detail.synopsis\"] { color: #696969; font-size: 13.6px; }\n[data-slot=\"detail\"] [data-part=\"button\"][data-variant=\"primary\"] { border-radius: 8px; background: #141414; color: #e8e8e8; font-weight: 700; }\n"
  }
}
